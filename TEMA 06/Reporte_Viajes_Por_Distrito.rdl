  <DataSources>
    <DataSource Name="dsMoviTrack">
      <rd:SecurityType>Integrated</rd:SecurityType>
      <ConnectionProperties>
        <DataProvider>SQL</DataProvider>
        <ConnectString>Data Source=DESKTOP-21KF01T\MSSQLSERVER01;Initial Catalog=MoviTrackTema05_Practica</ConnectString>
        <IntegratedSecurity>true</IntegratedSecurity>
      </ConnectionProperties>
      <rd:DataSourceID>814e3bdf-f4a6-4797-80cb-62f445b3ecbb</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="dsViajesDistrito">
      <Query>
        <DataSourceName>dsMoviTrack</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@Distrito">
            <Value>=Parameters!Distrito.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>-- TODO 2 resuelto: detalle de viajes del distrito seleccionado.
SELECT
    h.CodigoViaje,
    t.Fecha    AS Fecha,
    s.Servicio AS Servicio,
    u.Distrito AS Distrito,
    h.Importe  AS Importe
FROM dbo.FactViajeE04 AS h
INNER JOIN dbo.DimFechaE02 AS t
    ON t.FechaKey = h.FechaKey
INNER JOIN dbo.DimServicioE02 AS s
    ON s.ServicioKey = h.ServicioKey
INNER JOIN dbo.DimUbicacionE02 AS u
    ON u.UbicacionKey = h.UbicacionKey
WHERE u.Distrito = @Distrito
ORDER BY h.CodigoViaje;</CommandText>
      </Query>
      <Fields>
        <Field Name="CodigoViaje">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>CodigoViaje</DataField>
        </Field>
        <Field Name="Fecha">
          <rd:TypeName>System.DateTime</rd:TypeName>
          <DataField>Fecha</DataField>
        </Field>
        <Field Name="Servicio">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>Servicio</DataField>
        </Field>
        <Field Name="Distrito">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>Distrito</DataField>
        </Field>
        <Field Name="Importe">
          <rd:TypeName>System.Decimal</rd:TypeName>
          <DataField>Importe</DataField>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="dsDistritos">
      <Query>
        <DataSourceName>dsMoviTrack</DataSourceName>
        <CommandText>SELECT DISTINCT Distrito
FROM dbo.DimUbicacionE02
ORDER BY Distrito;</CommandText>
      </Query>
      <Fields>
        <Field Name="Distrito">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>Distrito</DataField>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
